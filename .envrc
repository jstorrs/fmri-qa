#!/bin/bash

# Stop on sync errors instead of activating a stale environment.
strict_env

# Re-sync when the workspace dependency declarations or Python version change.
watch_file pyproject.toml uv.lock .python-version packages packages/*/pyproject.toml

# Keep optional tooling installed by other sessions sharing this environment.
uv sync --all-packages --inexact
# shellcheck disable=SC1091
. .venv/bin/activate
