# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
# ...but not the hand-kept licence supplements (scripts/web_notices.py)
!web/notices/wheels/
*.egg-info

# Editor backups
*~

# Virtual environments
.venv

# Test / coverage / type-check caches
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.hypothesis/

# Jupyter
.ipynb_checkpoints/
# Exploratory scratch notebooks (see pyproject.toml ruff extend-exclude)
notebooks/

# Data / DICOM / BIDS (large binary inputs, not versioned)
data/
bids/
QA_FMRI_2025-10-07a/
*.zip

# The conventional output directory of a hand-run sphinx-build (sphinx-quickstart's
# `_build`); `make docs` builds the documentation site into build/site instead.
_build/

# The browser page (web/): npm dependencies, the vendored Pyodide and wheels
# `make web-vendor` downloads and builds, the built page and the boot test's
# generated fixture. The root `dist/` and `build/` patterns above match web/dist
# already; it is listed for the reader.
web/node_modules/
web/vendor/
web/dist/
web/test/fixtures/boot/
